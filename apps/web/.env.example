# ============================================================
# MINYX — Variables d'environnement
# Édition Meta AI Developer Hackathon — Track Indie Developer
# ------------------------------------------------------------
# Utilisation : copier ce fichier en « .env.local » puis renseigner les valeurs.
# .env.local ne doit JAMAIS être committé.
#
# Ce fichier est placé dans apps/web/ parce que c'est le répertoire depuis
# lequel Next.js charge les variables du serveur de développement.
# ============================================================

# ── Meta Model API (utilisée côté serveur uniquement) ───────
#
# Console développeur : https://dev.meta.ai
#
# ⚠️  Ne préfixez JAMAIS META_API_KEY par NEXT_PUBLIC_.
#     Tout ce qui commence par NEXT_PUBLIC_ est envoyé au navigateur.
#
# La clé n'est lue que par la route serveur /api/companion/chat.
META_API_KEY=

# Base de l'API, compatible avec le protocole OpenAI.
# Valeur par défaut appliquée par le code si la variable est absente :
#   https://api.meta.ai/v1
# L'appel effectué est : {META_API_BASE_URL}/chat/completions
META_API_BASE_URL=https://api.meta.ai/v1

# Identifiant du modèle de conversation et de raisonnement.
# À relever dans la console Meta Model API au moment de l'activation de la clé,
# puis à coller ici. Tant que cette valeur est vide, MINYX répond en mode
# scripté et l'interface l'indique explicitement.
META_TEXT_MODEL=

# ── Étape 3.2 — recherche web réelle (optionnel) ────────────
# Nécessaire uniquement quand web_search devra interroger un vrai moteur.
# SEARCH_API_KEY=
