# ============================================================
# MINYX — Variables d'environnement (production / docker compose)
# Copier ce fichier vers .env puis renseigner les valeurs.
#   cp .env.example .env
# ============================================================

# --- PostgreSQL (service `postgres` de docker-compose.yml) ---
POSTGRES_USER=minyx
# OBLIGATOIRE — générer avec : openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=minyx

# --- Application web ---
# OBLIGATOIRE — clé de signature des sessions JWT (>= 32 caractères)
# générer avec : openssl rand -base64 48
AUTH_SECRET=
# Origines autorisées pour les Server Actions (séparées par des virgules).
# Exemple : app.minyx.example.com,minyx.example.com
APP_ORIGINS=localhost:3000
# Port publié par le conteneur web
WEB_PORT=3000

# --- OAuth Google (optionnel : l'onglet reste masqué si absent) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- IA / recherche (optionnel) ---
# Sans clé, l'application répond en mode « scripted-fallback » explicitement
# étiqueté : aucune réponse n'est présentée comme issue d'un modèle.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=
TAVILY_API_KEY=
BRAVE_API_KEY=
EMBEDDING_API_KEY=
