{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["META_API_KEY", "META_API_BASE_URL", "META_TEXT_MODEL", "DATABASE_URL", "AUTH_SECRET"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "META_API_KEY",
        "META_API_BASE_URL",
        "META_TEXT_MODEL",
        "DATABASE_URL",
        "AUTH_SECRET",
        "TAVILY_API_KEY",
        "BRAVE_API_KEY",
        "EMBEDDING_API_KEY",
        "APP_ORIGINS"
      ]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
