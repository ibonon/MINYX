// ============================================================
// MINYX — Schéma de données PostgreSQL (PRODUCTION)
// Miroir de schema.prisma (SQLite/dev) avec :
//   - provider PostgreSQL
//   - extension pgvector + colonne/indicel `embedding` sur MemoryItem
// Utilisation :
//   DATABASE_URL="postgresql://…" \
//   npx prisma migrate deploy --schema prisma/schema.postgres.prisma
//   npx prisma generate       --schema prisma/schema.postgres.prisma
// Les migrations correspondantes vivent dans prisma/migrations-postgres/.
// ⚠ Toute modification de schema.prisma doit être répercutée ici.
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider         = "postgresql"
  url              = env("DATABASE_URL")
  extensions       = [vector]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  locale       String   @default("fr")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companions    Companion[]
  conversations Conversation[]
  memories      MemoryItem[]
  reminders     Reminder[]
  sessions      Session[]
}

/// Session serveur révocable. Le JWT porte l'id de session (`sid`) ;
/// la révocation (logout, compromission) prend effet immédiatement.
model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Companion {
  id        String   @id @default(cuid())
  userId    String
  name      String
  element   String
  form      String   @default("Chibi")
  level     Int      @default(1)
  xp        Int      @default(0)
  // Stats sérialisées { INT, EMO, AGI, BOND } — portable SQLite/Postgres
  statsJson String   @default("{\"INT\":28,\"EMO\":35,\"AGI\":22,\"BOND\":40}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  memories      MemoryItem[]
  reminders     Reminder[]

  @@index([userId])
}

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  companionId String
  title       String   @default("Nouvelle conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
  @@index([companionId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant" | "system"
  content        String
  // Traçabilité : origine réelle de la réponse (meta-api | scripted-fallback)
  source         String?
  modelUsed      String?
  toolCallJson   String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MemoryItem {
  id          String   @id @default(cuid())
  userId      String
  companionId String
  namespace   String // "core" | "events" | "preferences" | "moods"
  content     String
  importance  Float    @default(0.7)
  /// Vecteur d'embedding pgvector (1536 dims). Nullable : rempli quand une
  /// clé d'embeddings est configurée. Recherche ANN via index HNSW.
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([companionId, createdAt])
  @@index([userId])
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  companionId String
  title       String
  dueAt       DateTime
  timezone    String    @default("UTC")
  status      String    @default("scheduled") // scheduled | notified | done | cancelled
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companion Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([userId])
}
